# Copy to .env.setup and fill in. Never commit .env.setup.
# Read only by npm run db:setup and npm run db:verify. The running app never loads
# this file, so a compromise of the app does not expose the superuser password.

# --- Account that creates the schema, roles and privileges ---
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# --- Passwords for the other login roles. Choose your own. ---
# (dropboxed_app uses PGPASSWORD from .env.)
DB_DBA_PASSWORD=
DB_REPORT_PASSWORD=
DB_BACKUP_PASSWORD=

# --- First staff account created by npm run db:setup ---
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@dropboxed.local
ADMIN_PASSWORD=
