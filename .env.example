# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (standard libpq variables) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=dropboxed_db
PGUSER=postgres
PGPASSWORD=

# --- Application ---
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
APP_TIMEZONE=Asia/Manila
MAX_UPLOAD_MB=5
DUPLICATE_WINDOW_HOURS=72

# --- First staff account created by `npm run db:setup` ---
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@dropboxed.local
ADMIN_PASSWORD=
