# Copy to .env and fill in. Never commit .env.
# Read by the running application. Administrative credentials go in .env.setup.

# --- PostgreSQL (standard libpq variables) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=dropboxed_db
# The least-privilege runtime account, never a superuser. See docs/db-roles-setup.md.
PGUSER=dropboxed_app
# Choose a password. npm run db:setup sets it on dropboxed_app.
PGPASSWORD=
DB_POOL_MAX=10

# --- Application ---
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
APP_TIMEZONE=Asia/Manila
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
DUPLICATE_WINDOW_HOURS=72
