<%- include('../partials/header') %>
<%
  const base = { ...filters };
  const sortLabels = { newest: 'Newest first', oldest: 'Oldest first', status: 'Status (Pending first)', category: 'Category', barangay: 'Barangay' };
%>
<div class="page-head">
  <div>
    <h1>Complaints</h1>
    <p>Every complaint filed by San Pedro residents. Filter, sort, then open one to update it.</p>
  </div>
  <div class="actions">
    <a class="btn btn-secondary" href="/admin/reports/export.csv<%= h.query({ from: filters.from, to: filters.to }) %>"><%- h.icon('download') %>Export CSV</a>
  </div>
</div>

<section class="card" style="margin-bottom:16px">
  <form method="get" action="/admin/complaints" class="filters" role="search">
    <div class="field field-search">
      <label for="q">Search</label>
      <input id="q" name="q" type="search" placeholder="ID, resident, street or description" value="<%= filters.q %>">
    </div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="">Any status</option>
        <option value="open"<%= filters.status === 'open' ? ' selected' : '' %>>Open (not resolved)</option>
        <% for (const s of statuses) { %><option<%= filters.status === s ? ' selected' : '' %>><%= s %></option><% } %>
      </select>
    </div>
    <div class="field">
      <label for="category">Type</label>
      <select id="category" name="category">
        <option value="">Any type</option>
        <% for (const c of categories) { %><option value="<%= c.category_id %>"<%= filters.category === c.category_id ? ' selected' : '' %>><%= c.category_name %></option><% } %>
      </select>
    </div>
    <div class="field">
      <label for="barangay">Barangay</label>
      <select id="barangay" name="barangay">
        <option value="">Any barangay</option>
        <% for (const b of barangays) { %><option<%= filters.barangay === b ? ' selected' : '' %>><%= b %></option><% } %>
      </select>
    </div>
    <div class="field">
      <label for="sort">Sort</label>
      <select id="sort" name="sort">
        <% for (const [value, label] of Object.entries(sortLabels)) { %><option value="<%= value %>"<%= filters.sort === value ? ' selected' : '' %>><%= label %></option><% } %>
      </select>
    </div>
    <div class="filters-more">
      <div class="field">
        <label for="flagged">Review flag</label>
        <select id="flagged" name="flagged">
          <option value="">Flagged or not</option>
          <option value="yes"<%= filters.flagged === 'yes' ? ' selected' : '' %>>Flagged only</option>
          <option value="no"<%= filters.flagged === 'no' ? ' selected' : '' %>>Not flagged</option>
        </select>
      </div>
      <div class="field">
        <label for="assigned">Assigned to</label>
        <select id="assigned" name="assigned">
          <option value="">Anyone</option>
          <option value="me"<%= filters.assigned === 'me' ? ' selected' : '' %>>Me</option>
          <option value="none"<%= filters.assigned === 'none' ? ' selected' : '' %>>Unassigned</option>
          <% for (const s of staff) { %><option value="<%= s.staff_id %>"<%= filters.assigned === s.staff_id ? ' selected' : '' %>><%= s.full_name %></option><% } %>
        </select>
      </div>
      <div class="field">
        <label for="from">Submitted from</label>
        <input id="from" name="from" type="date" value="<%= filters.from %>">
      </div>
      <div class="field">
        <label for="to">Submitted to</label>
        <input id="to" name="to" type="date" value="<%= filters.to %>">
      </div>
      <div class="filter-actions">
        <button class="btn btn-primary" type="submit"><%- h.icon('search', 'icon icon-sm') %>Apply</button>
        <% if (activeFilterCount) { %><a class="btn btn-ghost" href="/admin/complaints">Clear</a><% } %>
      </div>
    </div>
  </form>
</section>

<section class="card card-flush">
  <div class="results-bar">
    <span><strong style="color:var(--ink)"><%= h.plural(result.total, 'complaint') %></strong><%= activeFilterCount ? ` match ${h.plural(activeFilterCount, 'filter')}` : '' %></span>
    <span>Sorted by <%= sortLabels[filters.sort].toLowerCase() %></span>
  </div>
  <% if (result.rows.length) { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>ID</th><th>Complaint</th><th>Location</th><th>Resident</th><th>Submitted</th><th>Status</th><th>Assigned</th></tr></thead>
        <tbody><%- include('../partials/complaint-rows', { rows: result.rows }) %></tbody>
      </table>
    </div>
    <% if (result.pages > 1) { %>
      <nav class="pagination" aria-label="Pages">
        <span>Page <%= result.page %> of <%= result.pages %> · showing <%= (result.page - 1) * result.pageSize + 1 %>–<%= Math.min(result.page * result.pageSize, result.total) %></span>
        <span class="pages">
          <% if (result.page > 1) { %><a class="btn btn-secondary btn-sm" href="/admin/complaints<%= h.query(base, { page: result.page - 1 }) %>"><%- h.icon('arrowLeft', 'icon icon-sm') %>Previous</a><% } %>
          <% if (result.page < result.pages) { %><a class="btn btn-secondary btn-sm" href="/admin/complaints<%= h.query(base, { page: result.page + 1 }) %>">Next<%- h.icon('arrowRight', 'icon icon-sm') %></a><% } %>
        </span>
      </nav>
    <% } %>
  <% } else { %>
    <div class="empty-state">
      <%- h.icon('search') %>
      <h3>No complaints match these filters</h3>
      <p><a href="/admin/complaints">Clear all filters</a></p>
    </div>
  <% } %>
</section>
<%- include('../partials/footer') %>
